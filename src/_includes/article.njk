---
layout: base.njk
---
<article class="h-entry article-content">
  <a class="u-url" href="{{ page.url }}" hidden>{{ title | escape }}</a>

  <header class="article-header">
    <h1 class="section-label p-name">// {{ title | escape }}</h1>
    <p class="article-meta">
      <time class="dt-published" datetime="{{ date | dateIso }}">{{ date | dateReadable }}</time>
      · {{ content | readingTime }} min read
      · by <a class="p-author h-card" href="/about/" rel="author">Stefano Sello</a>
      {% if updated %}· updated <time class="dt-updated" datetime="{{ updated | dateIso }}">{{ updated | dateReadable }}</time>{% endif %}
    </p>
  </header>

  <div class="e-content">
    {{ content | safe }}
  </div>

  <p class="article-back"><a href="/articles/">← /articles/</a></p>
</article>
