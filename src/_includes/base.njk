<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <script>/* prevent flash; storage may be unavailable */ (function(){try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);}catch(e){}}());</script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title | escape }}{% if ogType == "article" %} — {{ site.name | escape }}{% endif %}</title>
  <meta name="description" content="{{ description | escape }}" />
  <meta name="author" content="{{ site.name | escape }}" />
  <meta name="robots" content="max-image-preview:large" />
  <link rel="canonical" href="{{ page.url | absoluteUrl(site) | escape }}" />

  <!-- IndieWeb -->
  <link rel="webmention" href="https://webmention.io/stefanosello.me/webmention" />
  <link rel="authorization_endpoint" href="https://indieauth.com/auth" />
  <link rel="token_endpoint" href="https://tokens.indieauth.com/token" />
  <link rel="me" href="https://github.com/stefanosello" />
  <link rel="me" href="https://linkedin.com/in/stefano-sello" />
  <link rel="me" href="mailto:{{ site.email | escape }}" />

  <!-- Open Graph -->
  <meta property="og:type"        content="{{ ogType if ogType else 'website' }}" />
  <meta property="og:url"         content="{{ page.url | absoluteUrl(site) | escape }}" />
  <meta property="og:site_name"   content="{{ site.name | escape }}" />
  <meta property="og:locale"      content="en_GB" />
  <meta property="og:title"       content="{{ title | escape }}" />
  <meta property="og:description" content="{{ description | escape }}" />
  {% if ogImage %}<meta property="og:image" content="{{ ogImage | absoluteUrl(site) | escape }}" />{% endif %}
  <meta name="twitter:card"       content="summary" />
  {% if ogType == "article" %}
  <meta property="article:published_time" content="{{ date | dateIso }}" />
  {% if updated %}<meta property="article:modified_time" content="{{ updated | dateIso }}" />{% endif %}
  <meta property="article:author" content="{{ '/about/' | absoluteUrl(site) }}" />
  {% endif %}

  <script type="application/ld+json">{{ {url: page.url, title: title, description: description, ogType: ogType, date: date, updated: updated, ogImage: ogImage, breadcrumbTitle: breadcrumbTitle} | structuredData(site) | jsonLd | safe }}</script>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />

  <link rel="stylesheet" href="{{ '/style.css' | assetUrl }}" />
  {% if youtube %}<script src="{{ '/assets/youtube.js' | assetUrl }}" defer></script>{% endif %}
</head>
<body>
<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="container">

  <!-- ── Header ─────────────────────────────────────────── -->
  <header class="h-card">
    <button class="theme-toggle" id="theme-toggle" type="button" disabled>Toggle theme</button>
    <!-- h-card identity anchors -->
    <a class="u-url u-uid" href="https://stefanosello.me/" rel="me" hidden></a>

    {% if page.url == "/" %}<h1 class="prompt">{% else %}<p class="prompt">{% endif %}
      <a class="prompt-home" href="/"><span class="sr-only p-name">{{ site.name | escape }}</span><span class="prompt-glyph" aria-hidden="true">~$ </span><span id="typed-name" aria-hidden="true">stefano sello</span></a>
    {% if page.url == "/" %}</h1>{% else %}</p>{% endif %}
    <p class="subtitle p-job-title">Senior Software Engineer</p>
    <div class="contact-row">
      <a class="u-email" href="mailto:{{ site.email | escape }}" rel="me">{{ site.email | escape }}</a>
      <a href="https://github.com/stefanosello" target="_blank" rel="me noopener noreferrer">github.com/stefanosello</a>
      <a href="https://linkedin.com/in/stefano-sello" target="_blank" rel="me noopener noreferrer">linkedin.com/in/stefano-sello</a>
      <span><span class="p-locality">Treviso</span>, <span class="p-country-name">Italy</span></span>
    </div>
    <a class="btn-cv" href="/assets/CV_Stefano_Sello.pdf" download><span aria-hidden="true">↓ </span>download CV (PDF)</a>
    <canvas id="life-canvas" aria-hidden="true"></canvas>
  </header>

  <main id="main-content" tabindex="-1">
    {% if page.url != "/" %}
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        {% if ogType == "article" %}<li><a href="/articles/">Articles</a></li>{% endif %}
        <li aria-current="page">{% if breadcrumbTitle %}{{ breadcrumbTitle | escape }}{% elif ogType == "article" %}{{ title | escape }}{% elif page.url == "/about/" %}About{% else %}Articles{% endif %}</li>
      </ol>
    </nav>
    {% endif %}
    {{ content | safe }}
  </main>

  <!-- ── Footer ─────────────────────────────────────────── -->
  <footer>
    <p>~$ built by hand. no frameworks harmed. <span class="cursor" aria-hidden="true">█</span></p>
    <nav class="footer-badges" aria-label="Site navigation">
      {% if page.url != "/" %}<a class="badge" href="/">home</a>{% endif %}
      {% if page.url != "/about/" %}<a class="badge" href="/about/">about</a>{% endif %}
      {% if not page.url.startsWith("/articles") %}<a class="badge" href="/articles/">articles</a>{% endif %}
      <a class="badge" href="/privacy/"{% if page.url == "/privacy/" %} aria-current="page"{% endif %}>privacy</a>
      <a class="badge" href="https://indiewebify.me/validate-h-card/?url=https://stefanosello.me/" target="_blank" rel="noopener noreferrer">IndieWeb ✓</a>
    </nav>
  </footer>

</div>

<script>
  // ── Game of Life ──────────────────────────────────────────
  (function () {
    const canvas = document.getElementById('life-canvas');
    if (!canvas || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const CELL = 5;
    const INTERVAL = 120;
    let cols, rows, grid, next, animId, last = 0;

    function getGreen() {
      return getComputedStyle(document.documentElement)
        .getPropertyValue('--accent-green').trim();
    }

    function mkGrid(rand) {
      return Array.from({ length: cols }, () =>
        Uint8Array.from({ length: rows }, () => rand && Math.random() < 0.3 ? 1 : 0)
      );
    }

    function resize() {
      cancelAnimationFrame(animId);
      const dpr = window.devicePixelRatio || 1;
      const W = canvas.offsetWidth;
      const H = canvas.offsetHeight;
      canvas.width  = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.floor(W / CELL);
      rows = Math.floor(H / CELL);
      grid = mkGrid(true);
      next = mkGrid(false);
      last = 0;
      animId = requestAnimationFrame(loop);
    }

    function step() {
      for (let x = 0; x < cols; x++) {
        for (let y = 0; y < rows; y++) {
          let n = 0;
          for (let dx = -1; dx <= 1; dx++) {
            for (let dy = -1; dy <= 1; dy++) {
              if (dx === 0 && dy === 0) continue;
              n += grid[(x + dx + cols) % cols][(y + dy + rows) % rows];
            }
          }
          const a = grid[x][y];
          next[x][y] = (a ? n === 2 || n === 3 : n === 3) ? 1 : 0;
        }
      }
      [grid, next] = [next, grid];
    }

    function draw() {
      ctx.clearRect(0, 0, canvas.offsetWidth, canvas.offsetHeight);
      ctx.fillStyle = getGreen();
      for (let x = 0; x < cols; x++) {
        for (let y = 0; y < rows; y++) {
          if (grid[x][y]) ctx.fillRect(x * CELL + 0.5, y * CELL + 0.5, CELL - 1, CELL - 1);
        }
      }
    }

    function loop(ts) {
      animId = requestAnimationFrame(loop);
      if (ts - last < INTERVAL) return;
      last = ts;
      step();
      draw();
    }

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) cancelAnimationFrame(animId);
      else { last = 0; animId = requestAnimationFrame(loop); }
    });

    window.addEventListener('resize', resize);
    resize();
  })();

  // ── Typing animation ──────────────────────────────────────
  (function () {
    const el = document.getElementById('typed-name');
    if (!el) return;
    const text = 'stefano sello';
    let i = 0;
    function tick() {
      if (i <= text.length) {
        el.textContent = text.slice(0, i);
        i++;
        setTimeout(tick, i === 1 ? 300 : 80);
      }
    }
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = text;
    } else {
      tick();
    }
  })();

  // ── Theme toggle ──────────────────────────────────────────
  (function () {
    const toggle = document.getElementById('theme-toggle');
    const mql = window.matchMedia('(prefers-color-scheme: light)');

    function effective() {
      return document.documentElement.getAttribute('data-theme')
        || (mql.matches ? 'light' : 'dark');
    }

    function refresh() {
      const next = effective() === 'dark' ? 'light' : 'dark';
      toggle.textContent = next === 'light' ? '☀ light' : '☾ dark';
      toggle.setAttribute('aria-label', 'Switch to ' + next + ' colour scheme');
    }

    toggle.addEventListener('click', function () {
      const next = effective() === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) { /* keep the in-page preference */ }
      refresh();
    });

    mql.addEventListener('change', refresh);
    refresh();
    toggle.disabled = false;
  })();
</script>
</body>
</html>
